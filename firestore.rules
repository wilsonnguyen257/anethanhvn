rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'admin@gmail.com'
      ];
    }

    // Publicly readable site data: events, reflections, gallery index
    match /site-data/{doc} {
      allow read: if true; // anyone can read
      allow write: if isAdmin(); // only authenticated admins can write
      
      // Allow access to sub-collections (required for large data chunking)
      match /items/{item} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Site settings (homepage background, etc.)
    match /site-settings/{setting} {
      allow read: if true; // anyone can read settings
      allow write: if isAdmin(); // only authenticated admins can write
    }

    // Contact messages: any visitor can submit one, but only an admin can
    // read, update (mark answered), or delete them — unlike site-data above,
    // which is admin-authored and publicly readable, a message is
    // visitor-submitted and contains an email address, so it must not be
    // publicly readable. See src/lib/messages.ts.
    match /messages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'context', 'status', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.email.matches('.+@.+')
        && (!('context' in request.resource.data) || request.resource.data.context == null
            || (request.resource.data.context is string && request.resource.data.context.size() < 500))
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() < 320
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 5000
        && request.resource.data.status == 'pending';
    }

    // Audit logs - admins can write and read; logs hold admin emails and actions
    match /audit-logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // logs are immutable
    }

    // Admin activity tracking - for monitoring who's logged in
    match /admin-sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}

