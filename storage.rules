rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'admin@gmail.com'
      ];
    }

    // Uploads must be reasonably sized images (client checks are bypassable)
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Publicly readable gallery files
    match /gallery/{allPaths=**} {
      allow read: if true; // anyone can view
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Publicly readable event thumbnails
    match /events/{allPaths=**} {
      allow read: if true; // anyone can view event thumbnails
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Publicly readable reflection thumbnails
    match /reflections/{allPaths=**} {
      allow read: if true; // anyone can view reflection thumbnails
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Default: deny other paths unless you configure them
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
